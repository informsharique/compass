{
	"name": "compass",
	"version": "1.3.0",
	"private": true,
	"description": "A premium, high-performance, and beautifully designed mobile compass application built with React Native, Expo, and HeroUI Native.",
	"author": {
		"name": "Ahmad Shariq",
		"email": "informsharique@gmail.com",
		"url": "https://github.com/informsharique"
	},
	"contributors": [
		{
			"name": "Ahmad Shariq",
			"email": "informsharique@gmail.com",
			"url": "https://github.com/informsharique"
		}
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/informsharique/compass.git"
	},
	"bugs": {
		"url": "https://github.com/informsharique/compass/issues"
	},
	"homepage": "https://github.com/informsharique/compass#readme",
	"keywords": [
		"react-native",
		"expo",
		"compass",
		"sensors",
		"heroui-native",
		"uniwind",
		"tailwindcss",
		"mobile-app"
	],
	"main": "expo-router/entry",
	"scripts": {
		"start": "expo start",
		"android": "expo run:android",
		"ios": "expo run:ios",
		"ios:dev": "expo run:ios",
		"android:dev": "expo run:android",
		"prebuild": "expo prebuild",
		"prebuild:development": "EXPO_PUBLIC_APP_ENV=development STRICT_ENV_VALIDATION=1 bun run prebuild",
		"prebuild:production": "EXPO_PUBLIC_APP_ENV=production STRICT_ENV_VALIDATION=1 bun run prebuild",
		"build:development:ios": "eas build --profile development --platform ios",
		"build:development:android": "eas build --profile development --platform android",
		"build:production:ios": "eas build --profile production --platform ios",
		"build:production:android": "eas build --profile production --platform android",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@expo/metro-runtime": "~56.0.13",
		"expo": "~56.0.5",
		"expo-blur": "~56.0.3",
		"expo-build-properties": "~56.0.18",
		"expo-constants": "~56.0.16",
		"expo-dev-client": "~56.0.19",
		"expo-location": "~56.0.16",
		"expo-router": "~56.2.7",
		"expo-sensors": "~56.0.6",
		"expo-splash-screen": "~56.0.10",
		"expo-status-bar": "~56.0.4",
		"expo-system-ui": "~56.0.5",
		"heroui-native": "^1.0.2",
		"react": "19.2.3",
		"react-native": "0.85.3",
		"react-native-gesture-handler": "~2.31.2",
		"react-native-mmkv": "^4.3.1",
		"react-native-pulsar": "^1.6.1",
		"react-native-reanimated": "~4.3.1",
		"react-native-screens": "~4.25.2",
		"react-native-svg": "15.15.4",
		"react-native-worklets": "0.8.3",
		"tailwind-merge": "^3.4.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.1.17",
		"uniwind": "^1.5.0"
	},
	"devDependencies": {
		"@types/react": "~19.2.15",
		"dotenv": "^17.4.2",
		"eslint": "^9.39.4",
		"eslint-config-expo": "^56.0.4",
		"prettier": "^3.8.3",
		"react-native-svg-transformer": "^1.5.3",
		"typescript": "~6.0.3"
	}
}
